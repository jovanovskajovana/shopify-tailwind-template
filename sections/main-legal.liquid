<section class='py-[12.8vw] lg:py-[4.444vw] px-[4.267vw] lg:px-[3.333vw] mx-auto' data-legal-section>
    <div class='lg:max-w-[62.222vw] mx-auto opacity-0' data-legal-content>
    {%- if section.blocks.size > 0 -%}
      <nav class='flex flex-wrap gap-y-[2.133vw] lg:gap-y-[0.556vw] gap-x-[6.4vw] lg:gap-x-[1.667vw] mb-[8.533vw] lg:mb-[2.222vw]' aria-label='{{ 'sections.footer.legal' | t }}'>
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            {%- assign nav_page = block.settings.page -%}
            {%- if nav_page != blank -%}
              <a
                href='{{ nav_page.url }}'
                class='text-[3.733vw] lg:text-[0.972vw] {% if nav_page == page %}text-black-100 font-bold{% else %}text-gray-600 hover:text-black-100{% endif %} leading-[1.429]'
                {% if nav_page == page %}
                  aria-current='page'
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | default: nav_page.title }}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if page.title != blank -%}
      <h1 class='text-[8vw] lg:text-[2.5vw] font-bold leading-[1.2] lg:leading-[1.111] mb-[6.4vw] lg:mb-[2.222vw]'>{{ page.title }}</h1>
    {%- endif -%}

    <div class='space-y-[4.267vw] lg:space-y-[1.111vw] text-[4.267vw] lg:text-[1.111vw] text-gray-700 leading-relaxed [&>h2]:text-[6.4vw] lg:[&>h2]:text-[1.667vw] [&>h2]:font-bold [&>h2]:leading-[1.333] [&>h2]:mt-[8.533vw] lg:[&>h2]:mt-[2.222vw] [&>h2]:mb-[4.267vw] lg:[&>h2]:mb-[1.111vw] [&>h3]:text-[5.333vw] lg:[&>h3]:text-[1.389vw] [&>h3]:font-semibold [&>h3]:leading-[1.4] [&>h3]:mt-[6.4vw] lg:[&>h3]:mt-[1.667vw] [&>h3]:mb-[3.2vw] lg:[&>h3]:mb-[0.833vw] [&>p]:mb-[4.267vw] lg:[&>p]:mb-[1.111vw] [&>ul]:list-disc [&>ul]:ml-[6.4vw] lg:[&>ul]:ml-[1.667vw] [&>ul]:mb-[4.267vw] lg:[&>ul]:mb-[1.111vw] [&>ol]:list-decimal [&>ol]:ml-[6.4vw] lg:[&>ol]:ml-[1.667vw] [&>ol]:mb-[4.267vw] lg:[&>ol]:mb-[1.111vw] [&>li]:mb-[2.133vw] lg:[&>li]:mb-[0.556vw] [&>a]:text-black-100 [&>a]:underline [&>a]:hover:text-gray-600 [&>img]:max-w-full [&>img]:h-auto [&>img]:my-[6.4vw] lg:[&>img]:my-[1.667vw] [&>blockquote]:border-l-4 [&>blockquote]:border-gray-200 [&>blockquote]:pl-[4.267vw] lg:[&>blockquote]:pl-[1.111vw] [&>blockquote]:my-[6.4vw] lg:[&>blockquote]:my-[1.667vw] [&>blockquote]:italic'>
      {{ page.content }}
    </div>
  </div>
</section>

<script src='{{ 'main-legal.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.main-legal.name",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Page",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    }
  ]
}
{% endschema %}

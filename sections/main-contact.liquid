<section class='container mx-auto px-4 py-12'>
  <div class='text-center mb-12'>
    <h1 class='text-4xl md:text-5xl font-bold mb-4'>{{ page.title }}</h1>
    {%- if page.content != blank -%}
      <div class='max-w-3xl mx-auto text-lg text-gray-600'>
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>

  <div class='max-w-xl mx-auto'>
    <p class='text-lg text-center'>
      <a href='mailto:{{ section.settings.email }}' class='text-black underline hover:text-gray-600'>
        {{ section.settings.email }}
      </a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-contact.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@jovanovskajovana.com"
    }
  ]
}
{% endschema %}

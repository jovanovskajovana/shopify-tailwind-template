<section class='bg-white-100 border-b border-gray-200 text-black-100 py-2 overflow-hidden'>
  {% capture elements %}
    {% for block in section.blocks %}
      {% if block.settings.link %}
        <a href="{{ block.settings.link }}" target="_blank" class="inline-block text-xs tracking-wider uppercase px-8 hover:opacity-80">
          <span class="mr-2">•</span>
          {{ block.settings.item_text }}
        </a>
      {% else %}
        <span class="inline-block text-xs tracking-wider uppercase px-8">
          <span class="mr-2">•</span>
          {{ block.settings.item_text }}
        </span>
      {% endif %}
    {% endfor %}
  {% endcapture %}

  {% capture repeated %}
    {{ elements }}{{ elements }}{{ elements }}{{ elements }}{{ elements }}{{ elements }}{{ elements }}{{ elements }}
  {% endcapture %}

  <div class='flex whitespace-nowrap'>
    <div class='flex animate-marquee'>{{ repeated }}</div>
    <div class='flex animate-marquee'>{{ repeated }}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional link for the announcement"
        },
        {
          "type": "text",
          "id": "item_text",
          "label": "Text",
          "info": "Announcement text to display"
        }
      ]
    }
  ]
}
{% endschema %}

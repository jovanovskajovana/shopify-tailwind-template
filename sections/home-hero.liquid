<section
  class='relative flex items-center justify-center bg-gray-100 overflow-hidden min-h-[calc(100vh-var(--header-height,25.6vw))] lg:min-h-[calc(100vh-var(--header-height,6.667vw))]'
  data-home-hero-section
>
  {%- if section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: 2000
      | image_tag:
        widths: '600, 900, 1200, 1600, 2000',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: '',
        class: 'absolute inset-0 w-full h-full object-cover'
    }}
  {%- endif -%}
  <div class='relative text-center px-[4.267vw] lg:px-[3.333vw] mx-auto z-10'>
    {%- if section.settings.heading != blank -%}
      <h1 class='text-[9.6vw] lg:text-[4.167vw] font-bold leading-[1.111] lg:leading-[1] mb-[6.4vw] lg:mb-[1.667vw] opacity-0' data-hero-heading>
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class='text-[4.8vw] lg:text-[1.389vw] text-gray-700 leading-[1.556] lg:leading-[1.4] mb-[8.533vw] lg:mb-[2.222vw] opacity-0' data-hero-subheading>
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a
        href='{{ section.settings.button_link | default: routes.all_products_collection_url }}'
        class='inline-block bg-black-100 hover:bg-gray-800 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] text-white-100 leading-[1.5] py-[4.267vw] lg:py-[1.111vw] px-[8.533vw] lg:px-[2.222vw] transition-colors opacity-0'
        data-hero-button
      >
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</section>

<script src='{{ 'home-hero.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.home-hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our collection"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.home-hero.name"
    }
  ]
}
{% endschema %}

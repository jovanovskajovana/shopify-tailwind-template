<section class='lg:max-w-[62.222vw] py-[12.8vw] lg:py-[3.333vw] px-[4.267vw] lg:px-[3.333vw] mx-auto'>
  <h1 class='text-[8vw] lg:text-[2.083vw] font-bold leading-[1.2] mb-[8.533vw] lg:mb-[2.222vw]'>{{ 'customer.account.title' | t }}</h1>

  {%- comment -%} Account Details {%- endcomment -%}
  <div class='border border-gray-200 rounded-[2.133vw] lg:rounded-[0.556vw] p-[6.4vw] lg:p-[1.667vw] mb-[8.533vw] lg:mb-[2.222vw]'>
    <h2 class='text-[5.333vw] lg:text-[1.389vw] font-bold leading-[1.4] mb-[4.267vw] lg:mb-[1.111vw]'>{{ 'customer.account.details' | t }}</h2>
    <div class='space-y-[2.133vw] lg:space-y-[0.556vw]'>
      <p class='text-[4.267vw] lg:text-[1.111vw] leading-[1.5]'>
        <strong>{{ 'customer.account.details' | t }}:</strong> {{ customer.name }}
      </p>
      <p class='text-[4.267vw] lg:text-[1.111vw] leading-[1.5]'>
        <strong>{{ 'customer.login_page.email' | t }}:</strong> {{ customer.email }}
      </p>
    </div>
  </div>

  {%- comment -%} Account Actions {%- endcomment -%}
  <div class='flex flex-wrap gap-[4.267vw] lg:gap-[1.111vw]'>
    <a
      href='{{ routes.account_addresses_url }}'
      class='inline-block bg-black-100 hover:bg-gray-800 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] text-white-100 leading-[1.5] py-[2.133vw] lg:py-[0.556vw] px-[6.4vw] lg:px-[1.667vw] transition'
    >
      {{ 'customer.account.view_addresses' | t }}
    </a>
    <a
      href='{{ routes.account_orders_url }}'
      class='inline-block hover:bg-gray-100 border border-black-100 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] leading-[1.5] py-[2.133vw] lg:py-[0.556vw] px-[6.4vw] lg:px-[1.667vw] transition'
    >
      {{ 'customer.nav.orders' | t }}
    </a>
    <a
      href='{{ routes.account_logout_url }}'
      class='inline-block hover:bg-gray-100 border border-black-100 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] leading-[1.5] py-[2.133vw] lg:py-[0.556vw] px-[6.4vw] lg:px-[1.667vw] transition'
    >
      {{ 'customer.nav.log_out' | t }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "tag": "section"
}
{% endschema %}

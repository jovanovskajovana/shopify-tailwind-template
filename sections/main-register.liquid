<section class='lg:max-w-[31.111vw] py-[12.8vw] lg:py-[3.333vw] px-[4.267vw] lg:px-[3.333vw] mx-auto'>
  <h1 class='text-[8vw] lg:text-[2.083vw] font-bold leading-[1.2] text-center mb-[8.533vw] lg:mb-[2.222vw]'>{{ 'customer.login_page.create_account' | t }}</h1>

  {%- form 'create_customer', class: 'form', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class='bg-red-50 border border-red-200 rounded-[2.133vw] lg:rounded-[0.556vw] p-[4.267vw] lg:p-[1.111vw] mb-[6.4vw] lg:mb-[1.667vw]'>
        <h2 class='text-[4.267vw] lg:text-[1.111vw] text-red-800 font-semibold leading-[1.5] mb-[2.133vw] lg:mb-[0.556vw]'>{{ 'accessibility.error' | t }}</h2>
        <ul class='text-[3.733vw] lg:text-[0.972vw] text-red-700 leading-[1.429] list-disc list-inside'>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href='#{{ field }}'>
                  {{- form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class='mb-[4.267vw] lg:mb-[1.111vw]'>
      <label for='RegisterFirstName' class='block text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5] mb-[2.133vw] lg:mb-[0.556vw]'>
        {{ 'customer.register.first_name' | t }}
      </label>
      <input
        type='text'
        id='RegisterFirstName'
        name='customer[first_name]'
        autocomplete='given-name'
        value='{{ form.first_name }}'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded-[1.067vw] lg:rounded-[0.278vw] text-[4.267vw] lg:text-[1.111vw] leading-[1.5] w-full py-[2.133vw] lg:py-[0.556vw] px-[4.267vw] lg:px-[1.111vw] focus:outline-none'
        {% if form.errors contains 'first_name' %}
          aria-invalid='true'
          aria-describedby='first_name-error'
        {% endif %}
      >
      {%- if form.errors contains 'first_name' -%}
        <p id='first_name-error' class='text-[3.733vw] lg:text-[0.972vw] text-red-600 leading-[1.429] mt-[1.067vw] lg:mt-[0.278vw]'>{{ form.errors.messages.first_name }}</p>
      {%- endif -%}
    </div>

    <div class='mb-[4.267vw] lg:mb-[1.111vw]'>
      <label for='RegisterEmail' class='block text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5] mb-[2.133vw] lg:mb-[0.556vw]'>
        {{ 'customer.register.email' | t }}
      </label>
      <input
        type='email'
        id='RegisterEmail'
        name='customer[email]'
        autocomplete='email'
        value='{{ form.email }}'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded-[1.067vw] lg:rounded-[0.278vw] text-[4.267vw] lg:text-[1.111vw] leading-[1.5] w-full py-[2.133vw] lg:py-[0.556vw] px-[4.267vw] lg:px-[1.111vw] focus:outline-none'
        {% if form.errors contains 'email' %}
          aria-invalid='true'
          aria-describedby='email-error'
        {% endif %}
      >
      {%- if form.errors contains 'email' -%}
        <p id='email-error' class='text-[3.733vw] lg:text-[0.972vw] text-red-600 leading-[1.429] mt-[1.067vw] lg:mt-[0.278vw]'>{{ form.errors.messages.email }}</p>
      {%- endif -%}
    </div>

    <div class='mb-[6.4vw] lg:mb-[1.667vw]'>
      <label for='RegisterPassword' class='block text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5] mb-[2.133vw] lg:mb-[0.556vw]'>
        {{ 'customer.register.password' | t }}
      </label>
      <input
        type='password'
        id='RegisterPassword'
        name='customer[password]'
        autocomplete='new-password'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded-[1.067vw] lg:rounded-[0.278vw] text-[4.267vw] lg:text-[1.111vw] leading-[1.5] w-full py-[2.133vw] lg:py-[0.556vw] px-[4.267vw] lg:px-[1.111vw] focus:outline-none'
        {% if form.errors contains 'password' %}
          aria-invalid='true'
          aria-describedby='password-error'
        {% endif %}
      >
      {%- if form.errors contains 'password' -%}
        <p id='password-error' class='text-[3.733vw] lg:text-[0.972vw] text-red-600 leading-[1.429] mt-[1.067vw] lg:mt-[0.278vw]'>{{ form.errors.messages.password }}</p>
      {%- endif -%}
    </div>

    <button type='submit' class='bg-black-100 hover:bg-gray-800 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] text-white-100 leading-[1.5] w-full py-[3.2vw] lg:py-[0.833vw] px-[8.533vw] lg:px-[2.222vw] transition'>
      {{ 'customer.register.submit' | t }}
    </button>

    <p class='text-[3.733vw] lg:text-[0.972vw] text-gray-600 leading-[1.429] text-center mt-[4.267vw] lg:mt-[1.111vw]'>
      Already have an account?
      <a href='{{ routes.account_login_url }}' class='hover:text-gray-800 underline'>
        {{ 'customer.login_page.log_in' | t }}
      </a>
    </p>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "tag": "section"
}
{% endschema %}

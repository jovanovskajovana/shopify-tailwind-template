<section class='max-w-md py-12 px-4 md:px-8 lg:px-12 mx-auto'>
  <h1 class='text-3xl font-bold text-center mb-8'>{{ 'customer.login_page.create_account' | t }}</h1>

  {%- form 'create_customer', class: 'form', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class='bg-red-50 border border-red-200 rounded-lg p-4 mb-6'>
        <h2 class='text-red-800 font-semibold mb-2'>{{ 'accessibility.error' | t }}</h2>
        <ul class='text-sm text-red-700 list-disc list-inside'>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href='#{{ field }}'>
                  {{- form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class='mb-4'>
      <label for='RegisterFirstName' class='block font-semibold mb-2'>
        {{ 'customer.register.first_name' | t }}
      </label>
      <input
        type='text'
        id='RegisterFirstName'
        name='customer[first_name]'
        autocomplete='given-name'
        value='{{ form.first_name }}'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded w-full py-2 px-4 focus:outline-none'
        {% if form.errors contains 'first_name' %}
          aria-invalid='true'
          aria-describedby='first_name-error'
        {% endif %}
      >
      {%- if form.errors contains 'first_name' -%}
        <p id='first_name-error' class='text-sm text-red-600 mt-1'>{{ form.errors.messages.first_name }}</p>
      {%- endif -%}
    </div>

    <div class='mb-4'>
      <label for='RegisterEmail' class='block font-semibold mb-2'>
        {{ 'customer.register.email' | t }}
      </label>
      <input
        type='email'
        id='RegisterEmail'
        name='customer[email]'
        autocomplete='email'
        value='{{ form.email }}'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded w-full py-2 px-4 focus:outline-none'
        {% if form.errors contains 'email' %}
          aria-invalid='true'
          aria-describedby='email-error'
        {% endif %}
      >
      {%- if form.errors contains 'email' -%}
        <p id='email-error' class='text-sm text-red-600 mt-1'>{{ form.errors.messages.email }}</p>
      {%- endif -%}
    </div>

    <div class='mb-6'>
      <label for='RegisterPassword' class='block font-semibold mb-2'>
        {{ 'customer.register.password' | t }}
      </label>
      <input
        type='password'
        id='RegisterPassword'
        name='customer[password]'
        autocomplete='new-password'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded w-full py-2 px-4 focus:outline-none'
        {% if form.errors contains 'password' %}
          aria-invalid='true'
          aria-describedby='password-error'
        {% endif %}
      >
      {%- if form.errors contains 'password' -%}
        <p id='password-error' class='text-sm text-red-600 mt-1'>{{ form.errors.messages.password }}</p>
      {%- endif -%}
    </div>

    <button type='submit' class='bg-black hover:bg-gray-800 rounded-lg text-white w-full py-3 px-8 transition'>
      {{ 'customer.register.submit' | t }}
    </button>

    <p class='text-sm text-gray-600 text-center mt-4'>
      Already have an account?
      <a href='{{ routes.account_login_url }}' class='hover:text-gray-800 underline'>
        {{ 'customer.login_page.log_in' | t }}
      </a>
    </p>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "tag": "section"
}
{% endschema %}

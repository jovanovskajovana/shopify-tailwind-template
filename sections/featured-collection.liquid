<section class='py-[12.8vw] lg:py-[3.333vw] px-[4.267vw] lg:px-[3.333vw] mx-auto' data-featured-collection-section>
  {%- if section.settings.heading != blank -%}
    <div class='text-center mb-[12.8vw] lg:mb-[3.333vw]'>
      <h2 class='text-[9.6vw] lg:text-[3.333vw] font-bold leading-[1.111] lg:leading-[1] mb-[4.267vw] lg:mb-[1.111vw] opacity-0' data-featured-heading>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if section.settings.collection != blank -%}
    {%- assign featured_collection = section.settings.collection -%}
  {%- else -%}
    {%- assign featured_collection = collections.all -%}
  {%- endif -%}

  {%- if featured_collection.products.size > 0 -%}
    <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[6.4vw] lg:gap-[2.222vw] opacity-0' data-featured-products>
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        {% render 'card-product-medium', card_product: product, section_id: section.id %}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and featured_collection.url != blank -%}
      <div class='text-center mt-[12.8vw] lg:mt-[3.333vw] opacity-0' data-featured-button>
        <a
          href='{{ featured_collection.url }}'
          class='inline-block bg-black-100 hover:bg-gray-800 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] text-white-100 leading-[1.5] py-[4.267vw] lg:py-[1.111vw] px-[8.533vw] lg:px-[2.222vw] transition-colors'
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<script src='{{ 'featured-collection.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.name"
    }
  ]
}
{% endschema %}

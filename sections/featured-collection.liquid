<section class='max-w-screen-2xl py-12 px-4 md:px-8 lg:px-12 mx-auto' data-featured-collection-section>
  {%- if section.settings.heading != blank -%}
    <div class='text-center mb-12'>
      <h2 class='text-4xl md:text-5xl font-bold mb-4 opacity-0' data-featured-heading>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if section.settings.collection != blank -%}
    {%- assign featured_collection = section.settings.collection -%}
  {%- else -%}
    {%- assign featured_collection = collections.all -%}
  {%- endif -%}

  {%- if featured_collection.products.size > 0 -%}
    <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8 [&>*]:opacity-0' data-featured-grid>
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        {% render 'card-product-medium', card_product: product, section_id: section.id %}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and featured_collection.url != blank -%}
      <div class='text-center mt-12'>
        <a
          href='{{ featured_collection.url }}'
          class='inline-block bg-black-100 hover:bg-gray-800 rounded-lg text-white-100 py-4 px-8 transition-colors opacity-0'
          data-featured-button
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<script src='{{ 'featured-collection.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.name"
    }
  ]
}
{% endschema %}

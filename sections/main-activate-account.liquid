<section class='max-w-md py-12 px-4 md:px-8 lg:px-12 mx-auto'>
  <h1 class='text-3xl font-bold text-center mb-4'>{{ 'customer.activate_account.title' | t }}</h1>
  {%- assign subtext = 'customer.activate_account.subtext' | t -%}
  {%- if subtext != blank -%}
    <p class='text-gray-600 text-center mb-8'>{{ subtext }}</p>
  {%- endif -%}

  {%- form 'activate_customer_password', class: 'form', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class='bg-red-50 border border-red-200 rounded-lg p-4 mb-6'>
        <h2 class='text-red-800 font-semibold mb-2'>{{ 'accessibility.error' | t }}</h2>
        <ul class='text-sm text-red-700 list-disc list-inside'>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href='#{{ field }}'>
                  {{- form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class='mb-4'>
      <label for='password' class='block font-semibold mb-2'>
        {{ 'customer.activate_account.password' | t }}
      </label>
      <input
        type='password'
        id='password'
        name='customer[password]'
        autocomplete='new-password'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded w-full py-2 px-4 focus:outline-none'
        {% if form.errors contains 'password' %}
          aria-invalid='true'
          aria-describedby='password-error'
        {% endif %}
      >
      {%- if form.errors contains 'password' -%}
        <p id='password-error' class='text-sm text-red-600 mt-1'>{{ form.errors.messages.password }}</p>
      {%- endif -%}
    </div>

    <div class='mb-6'>
      <label for='password_confirmation' class='block font-semibold mb-2'>
        {{ 'customer.activate_account.password_confirm' | t }}
      </label>
      <input
        type='password'
        id='password_confirmation'
        name='customer[password_confirmation]'
        autocomplete='new-password'
        class='border border-gray-300 focus:ring-2 focus:ring-black rounded w-full py-2 px-4 focus:outline-none'
        {% if form.errors contains 'password_confirmation' %}
          aria-invalid='true'
          aria-describedby='password_confirmation-error'
        {% endif %}
      >
      {%- if form.errors contains 'password_confirmation' -%}
        <p id='password_confirmation-error' class='text-sm text-red-600 mt-1'>{{ form.errors.messages.password_confirmation }}</p>
      {%- endif -%}
    </div>

    <div class='flex gap-4'>
      <button type='submit' class='bg-black hover:bg-gray-800 rounded-lg text-white py-3 px-8 flex-1 transition'>
        {{ 'customer.activate_account.submit' | t }}
      </button>
      <a
        href='{{ routes.root_url }}'
        class='hover:bg-gray-100 border border-black rounded-lg text-center py-3 px-8 flex-1 transition'
      >
        {{ 'customer.activate_account.cancel' | t }}
      </a>
    </div>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "tag": "section"
}
{% endschema %}

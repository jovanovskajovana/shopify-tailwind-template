<section class='text-center max-w-screen-2xl py-20 px-4 md:px-8 lg:px-12 mx-auto'>
  <h1 class='text-4xl md:text-6xl font-bold mb-6'>{{ 'templates.404.title' | t }}</h1>
  <p class='text-lg md:text-xl text-gray-600 mb-8'>{{ 'templates.404.subtitle' | t }}</p>
  <a
    href='{{ routes.root_url }}'
    class='inline-block bg-black hover:bg-gray-800 rounded-lg text-white py-4 px-8 transition'
  >
    {{ 'templates.404.button' | t }}
  </a>
</section>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "tag": "section",
  "settings": []
}
{% endschema %}

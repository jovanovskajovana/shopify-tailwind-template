<section
  class='flex flex-col items-center justify-center gap-[8.533vw] lg:gap-[2.222vw] text-center min-h-[calc(100vh-var(--header-height,25.6vw))] lg:min-h-[calc(100vh-var(--header-height,6.667vw))] px-[4.267vw] lg:px-[3.333vw]'
  data-404-section
>
  <h1 class='text-[21.333vw] lg:text-[8.333vw] font-bold leading-none opacity-0' data-404-heading>
    <span class='sr-only'>{{ 'templates.404.title' | t }}</span>
    <span aria-hidden='true'>404</span>
  </h1>
  <p class='text-[4.267vw] lg:text-[1.111vw] text-gray-600 leading-[1.556] lg:leading-[1.4] max-w-[86vw] lg:max-w-[36vw] opacity-0' data-404-subtitle>
    {{ 'templates.404.subtitle' | t }}
  </p>
  <a
    href='{{ routes.root_url }}'
    class='inline-block bg-black-100 hover:bg-gray-800 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] text-white-100 leading-[1.5] py-[4.267vw] lg:py-[1.111vw] px-[8.533vw] lg:px-[2.222vw] transition-colors opacity-0'
    data-404-cta
  >
    {{ 'templates.404.button' | t }}
  </a>
</section>

<script src='{{ 'main-404.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "tag": "section",
  "settings": []
}
{% endschema %}

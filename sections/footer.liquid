<footer class='bg-gray-900 text-white py-12'>
  <div class='max-w-screen-2xl px-4 md:px-8 lg:px-12 mx-auto'>
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8'>
      {%- comment -%} Shop Links {%- endcomment -%}
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <div>
            <h3 class='text-lg text-white-100 font-bold mb-4'>{{ link.title }}</h3>
            {%- if link.links != blank -%}
              <ul class='space-y-2'>
                {%- for childlink in link.links -%}
                  <li>
                    <a href='{{ childlink.url }}' class='text-gray-400 hover:text-gray-300'>{{ childlink.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Contact Info {%- endcomment -%}
      {%- if section.settings.contact_info != blank -%}
        <div>
          <h3 class='text-lg text-white-100 font-bold mb-4'>{{ section.settings.contact_heading }}</h3>
          <a href='mailto:{{ section.settings.contact_info }}' class='text-gray-400 hover:text-gray-300'>
            {{ section.settings.contact_info }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- capture legal_links -%}
      {%- assign legal_handles = 'privacy-policy,terms-and-conditions,cookie-policy' | split: ',' -%}
      {%- for handle in legal_handles -%}
        {%- assign legal_page = pages[handle] -%}
        {%- if legal_page != blank -%}
          <li>
            <a href='{{ legal_page.url }}' class='text-white-100 hover:text-gray-300'>{{ legal_page.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if legal_links != blank -%}
      <div class='border-t border-gray-800 pt-8 mt-8'>
        <ul class='flex flex-wrap justify-center gap-4 text-sm'>
          {{ legal_links }}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} Copyright {%- endcomment -%}
    <div class='border-t border-gray-800 text-gray-400 text-center pt-8 mt-8'>
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "contact_info",
      "label": "Contact Information"
    }
  ]
}
{% endschema %}

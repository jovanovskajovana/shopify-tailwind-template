<footer class='bg-gray-900 text-white-100 py-[12.8vw] lg:py-[3.333vw]' data-footer-section>
  <div class='px-[4.267vw] lg:px-[3.333vw] mx-auto opacity-0' data-footer-reveal>
    <div class='grid grid-cols-1 lg:grid-cols-4 gap-[8.533vw] lg:gap-[2.222vw]'>
      {%- comment -%} Shop Links {%- endcomment -%}
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <div>
            <h3 class='text-[4.8vw] lg:text-[1.25vw] text-white-100 font-bold leading-[1.556] mb-[4.267vw] lg:mb-[1.111vw]'>{{ link.title }}</h3>
            {%- if link.links != blank -%}
              <ul class='space-y-[2.133vw] lg:space-y-[0.556vw]'>
                {%- for childlink in link.links -%}
                  <li>
                    <a href='{{ childlink.url }}' class='text-[4.267vw] lg:text-[1.111vw] text-gray-400 hover:text-gray-300 leading-[1.5]'>{{ childlink.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Contact Info {%- endcomment -%}
      {%- if section.settings.contact_info != blank -%}
        <div>
          <h3 class='text-[4.8vw] lg:text-[1.25vw] text-white-100 font-bold leading-[1.556] mb-[4.267vw] lg:mb-[1.111vw]'>{{ section.settings.contact_heading }}</h3>
          <a href='mailto:{{ section.settings.contact_info }}' class='text-[4.267vw] lg:text-[1.111vw] text-gray-400 hover:text-gray-300 leading-[1.5]'>
            {{ section.settings.contact_info }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- capture legal_links -%}
      {%- assign legal_handles = 'privacy-policy,terms-and-conditions,cookie-policy' | split: ',' -%}
      {%- for handle in legal_handles -%}
        {%- assign legal_page = pages[handle] -%}
        {%- if legal_page != blank -%}
          <li>
            <a href='{{ legal_page.url }}' class='text-white-100 hover:text-gray-300'>{{ legal_page.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if legal_links != blank -%}
      <div class='border-t border-gray-800 pt-[8.533vw] lg:pt-[2.222vw] mt-[8.533vw] lg:mt-[2.222vw]'>
        <ul class='flex flex-wrap justify-center gap-[4.267vw] lg:gap-[1.111vw] text-[3.733vw] lg:text-[0.972vw] leading-[1.429]'>
          {{ legal_links }}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} Copyright {%- endcomment -%}
    <div class='border-t border-gray-800 text-gray-400 text-center pt-[8.533vw] lg:pt-[2.222vw] mt-[8.533vw] lg:mt-[2.222vw]'>
      <p class='text-[4.267vw] lg:text-[1.111vw] leading-[1.5]'>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script src='{{ 'footer.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "contact_info",
      "label": "Contact Information"
    }
  ]
}
{% endschema %}

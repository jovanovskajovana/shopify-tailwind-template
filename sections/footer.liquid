<footer class='bg-gray-900 text-white py-12'>
  <div class='max-w-screen-2xl px-4 md:px-8 lg:px-12 mx-auto'>
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8'>
      {%- comment -%} Shop Links {%- endcomment -%}
      {%- if linklists.footer != blank -%}
        {%- for link in linklists.footer.links -%}
          <div>
            <h3 class='text-lg font-bold mb-4'>{{ link.title }}</h3>
            {%- if link.links != blank -%}
              <ul class='space-y-2'>
                {%- for childlink in link.links -%}
                  <li>
                    <a href='{{ childlink.url }}' class='hover:text-gray-300'>{{ childlink.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Contact Info {%- endcomment -%}
      {%- if section.settings.contact_info != blank -%}
        <div>
          <h3 class='text-lg text-white-100 font-bold mb-4'>{{ section.settings.contact_heading }}</h3>
          <a href='mailto:{{ section.settings.contact_info }}' class='text-gray-400 hover:text-gray-300'>
            {{ section.settings.contact_info }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Policy Links {%- endcomment -%}
    {%- if shop.policies.size > 0 -%}
      <div class='border-t border-gray-800 pt-8 mt-8'>
        <ul class='flex flex-wrap justify-center gap-4 text-sm'>
          {%- for policy in shop.policies -%}
            <li>
              <a href='{{ policy.url }}' class='text-white-100 hover:text-gray-300'>{{ policy.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} Copyright {%- endcomment -%}
    <div class='border-t border-gray-800 text-gray-400 text-center pt-8 mt-8'>
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "contact_info",
      "label": "Contact Information"
    }
  ]
}
{% endschema %}

<section class='max-w-screen-2xl py-12 px-4 md:px-8 lg:px-12 mx-auto' data-collection-section>
  <div class='text-center mb-12 opacity-0' data-collection-heading>
    <h1 class='text-4xl md:text-5xl font-bold mb-4'>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class='text-lg text-gray-600 max-w-3xl mx-auto'>
        {{ collection.description }}
      </div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page | default: 24 -%}
    {%- if collection.products.size == 0 -%}
      <div class='text-center py-20'>
        <h2 class='text-2xl mb-6'>{{ 'sections.collection_template.empty' | t }}</h2>
        <a
          href='{{ routes.root_url }}'
          class='inline-block bg-black-100 hover:bg-gray-800 rounded-lg text-white-100 py-4 px-8 transition-colors'
        >
          {{ 'sections.collection_template.button' | t }}
        </a>
      </div>
    {%- else -%}
      <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8 [&>*]:opacity-0' data-collection-grid>
        {%- for product in collection.products -%}
          {% render 'card-product-medium', card_product: product, section_id: section.id %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav role='navigation' aria-label='Pagination' class='mt-12'>
          <ul class='flex flex-wrap justify-center gap-2'>
            {%- if paginate.previous -%}
              <li>
                <a
                  href='{{ paginate.previous.url }}'
                  class='hover:bg-gray-100 border border-gray-300 rounded py-2 px-4 transition'
                >
                  {{ 'accessibility.previous' | t }}
                </a>
              </li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a
                    href='{{ part.url }}'
                    class='hover:bg-gray-100 border border-gray-300 rounded py-2 px-4 transition'
                  >
                    {{ part.title }}
                  </a>
                {%- else -%}
                  <span class='bg-gray-100 border border-gray-300 rounded py-2 px-4'>
                    {{ part.title }}
                  </span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li>
                <a
                  href='{{ paginate.next.url }}'
                  class='hover:bg-gray-100 border border-gray-300 rounded py-2 px-4 transition'
                >
                  {{ 'accessibility.next' | t }}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</section>

<script src='{{ 'main-collection.js' | asset_url }}' defer='defer'></script>

{% schema %}
{
  "name": "t:sections.main-collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}

<script src='{{ 'media-gallery.js' | asset_url }}' defer='defer'></script>

{% comment %}
  Renders a product media gallery to be used on product page.

  Accepts:
  - class: {String} a class to be added to the container (optional)
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant

  Usage:
  {% render 'product-media-gallery',
    class: 'my-class',
    product: product,
    variant_images: variant_images
  %}
{% endcomment %}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign selected_variant_images = selected_variant.metafields.custom.gallery.value
  if selected_variant_images == blank
    assign selected_variant_images = product.images
  endif
  assign selected_variant_image = selected_variant_images | first

  # Build variant galleries JSON
  assign variant_galleries = ''
  for variant in product.variants
    assign gallery_data = variant.metafields.custom.gallery.value
    if gallery_data == blank
      assign gallery_data = product.images
    endif

    assign image_urls = '['
    for image in gallery_data
      assign image_url = image | image_url: width: 1600 | json
      if forloop.last
        assign image_urls = image_urls | append: image_url
      else
        assign image_urls = image_urls | append: image_url | append: ','
      endif
    endfor
    assign image_urls = image_urls | append: ']'
    assign variant_gallery = '{"id":"' | append: variant.id | append: '","gallery":' | append: image_urls | append: '}'

    if variant_galleries != ''
      assign variant_galleries = variant_galleries | append: ','
    endif
    assign variant_galleries = variant_galleries | append: variant_gallery
  endfor
%}
<script type='module'>
  if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
    const handleVariantChange = ({ data: { variant } }) => {
      if (!variant?.id) return

      const mediaGallery = document.querySelector('media-gallery')
      if (!mediaGallery) return

      let variantGalleries
      try {
        variantGalleries = JSON.parse(mediaGallery.dataset.variantGalleries)
      } catch (e) {
        return
      }

      const selectedGallery = variantGalleries.find((gallery) => gallery.id === variant.id.toString()) || variantGalleries[0]
      if (!selectedGallery?.gallery?.length) return

      const galleryContainer = document.getElementById('product-gallery')
      if (!galleryContainer) return

      const galleryWidths = [400, 800, 1200, 1600]
      const gallerySizes = '(min-width: 992px) 50vw, 100vw'

      const withWidth = (url, width) => {
        const parsed = new URL(url, window.location.origin)
        parsed.searchParams.set('width', String(width))
        return parsed.toString()
      }

      const setResponsive = (img, url) => {
        img.src = withWidth(url, 1600)
        img.srcset = galleryWidths.map((width) => `${withWidth(url, width)} ${width}w`).join(', ')
        img.sizes = gallerySizes
      }

      // Update thumbnail
      const thumbnailImg = galleryContainer.querySelector('.img-thumbnail')
      if (thumbnailImg && selectedGallery.gallery[0]) {
        setResponsive(thumbnailImg, selectedGallery.gallery[0])
      }

      // Clear existing gallery images (not thumbnail or controls)
      galleryContainer.querySelectorAll('.gallery-img').forEach((img) => img.remove())

      // Create new gallery images stacked absolutely
      const imageContainer = galleryContainer.querySelector('.relative')
      const controlsContainer = imageContainer?.querySelector('.gallery-controls-container')
      const fragment = document.createDocumentFragment()
      selectedGallery.gallery.forEach((imageUrl, index) => {
        if (index === 0) return
        const img = document.createElement('img')
        setResponsive(img, imageUrl)
        img.className = 'gallery-img absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700 ease-gallery'
        img.alt = ''
        img.width = '1000'
        img.height = 'auto'
        img.loading = 'lazy'
        img.setAttribute('aria-hidden', 'true')
        fragment.appendChild(img)
      })

      if (controlsContainer) {
        imageContainer.insertBefore(fragment, controlsContainer)
      } else if (imageContainer) {
        imageContainer.appendChild(fragment)
      }

      mediaGallery.reinitialize()
    }

    const onVariantChangeUnsubscriber = subscribe(PUB_SUB_EVENTS.variantChange, handleVariantChange)
    if (typeof document.addEventListener !== 'undefined') {
      document.addEventListener('turbo:before-cache', onVariantChangeUnsubscriber)
    }
  }
</script>

<media-gallery
  id='MediaGallery-{{ section.id }}'
  role='region'
  aria-label='{{ 'products.product.media.gallery_viewer' | t }}'
  data-desktop-layout='{{ section.settings.gallery_layout }}'
  data-variant-galleries='[{{ variant_galleries | join: "," }}]'
>
  <div class='sr-only' role='status' id='GalleryStatus-{{ section.id }}'></div>
  <div class='relative{% if class %} {{ class }}{% endif %}' id='product-gallery'>
    <div class='relative rounded-lg overflow-hidden'>
      {%- if selected_variant_image != blank -%}
        {{
          selected_variant_image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 800, 1200, 1600',
            sizes: '(min-width: 992px) 50vw, 100vw',
            alt: product.title,
            class: 'w-full h-auto img-thumbnail transition-opacity duration-700 ease-gallery',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- endif -%}
      {%- for media in selected_variant_images -%}
        {%- if forloop.first -%}
          {%- continue -%}
        {%- endif -%}
        {{
          media
          | image_url: width: 1600
          | image_tag:
            widths: '400, 800, 1200, 1600',
            sizes: '(min-width: 992px) 50vw, 100vw',
            alt: product.title,
            class: 'absolute inset-0 w-full h-full gallery-img object-cover opacity-0 transition-opacity duration-700 ease-gallery',
            loading: 'lazy',
            aria-hidden: 'true'
        }}
      {%- endfor -%}
      <div class='absolute inset-0 flex items-center justify-between pointer-events-none gallery-controls-container'>
        <button
          class='absolute left-4 flex items-center justify-center bg-black bg-opacity-50 hover:bg-opacity-70 rounded-full w-10 h-10 pointer-events-auto'
          id='gallery-left-btn'
          aria-label='{{ 'accessibility.previous' | t }}'
        >
          {{- 'icon-arrow-left-white.svg' | inline_asset_content -}}
        </button>
        <button
          class='absolute right-4 flex items-center justify-center bg-black bg-opacity-50 hover:bg-opacity-70 rounded-full w-10 h-10 pointer-events-auto'
          id='gallery-right-btn'
          aria-label='{{ 'accessibility.next' | t }}'
        >
          {{- 'icon-arrow-right-white.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>
  </div>
</media-gallery>

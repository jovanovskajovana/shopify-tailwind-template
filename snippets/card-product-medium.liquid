{% comment %}
  Renders a medium version of the product card

  Accepts:
  - class: {String} a class to be added to the container (optional)
  - card_product: {Object} Product Liquid object
  - section_id: {String} The ID of the section that contains this card

  Usage:
  {% render 'card-product-medium',
    class: 'my-class',
    card_product: product,
    section_id: section.id
  %}
{% endcomment %}
{% liquid
  assign card_image = card_product.featured_media
  if request.path == '/collections/all' and card_product.metafields.custom.product_grid_image != blank
    assign card_image = card_product.metafields.custom.product_grid_image
  endif
%}

<div class='{% if class %} {{ class }}{% endif %}'>
  <a
    href='{{ card_product.url }}'
    id='CardLink-{{ section_id }}-{{ card_product.id }}'
    aria-labelledby='CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}'
    class='block'
  >
    <div class='aspect-square overflow-hidden'>
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 1700px) 25vw, (min-width: 1200px) 33vw, (min-width: 672px) 50vw, 100vw',
            alt: card_product.title,
            class: 'w-full h-full object-cover',
            loading: 'lazy'
        }}
      {%- endif -%}
    </div>
  </a>
  <div class='mt-[4.267vw] lg:mt-[1.111vw]'>
    {%- if card_product.metafields.custom.thumbnail_image != blank -%}
      <div class='mb-[2.133vw] lg:mb-[0.556vw]'>
        {{
          card_product.metafields.custom.thumbnail_image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 1700px) 25vw, (min-width: 1200px) 33vw, (min-width: 672px) 50vw, 100vw',
            alt: card_product.title,
            class: 'w-full h-auto',
            loading: 'lazy'
        }}
      </div>
    {%- endif -%}
    <div>
      <h3 class='text-[5.333vw] lg:text-[1.389vw] font-semibold leading-[1.4] mb-[2.133vw] lg:mb-[0.556vw]' id='title-{{ section_id }}-{{ card_product.id }}'>
        {{ card_product.title | escape }}
      </h3>
      <div class='mb-[4.267vw] lg:mb-[1.111vw]'>
        {% render 'price', product: card_product, show_compare_at_price: true, starting_price: true %}
      </div>

      {% assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id %}

      <div class='no-js-hidden'>
        <modal-opener data-modal='#QuickAdd-{{ card_product.id }}'>
          <button
            id='{{ product_form_id }}-submit'
            type='submit'
            name='add'
            class='hover:bg-gray-100 border border-black-100 rounded-[2.133vw] lg:rounded-[0.556vw] text-[4.267vw] lg:text-[1.111vw] leading-[1.5] w-full py-[3.2vw] lg:py-[0.833vw] px-[6.4vw] lg:px-[1.667vw] transition'
            aria-haspopup='dialog'
            aria-labelledby='{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}'
            data-product-url='{{ card_product.url }}'
          >
            {{ 'products.product.quick_view' | t }}
          </button>
        </modal-opener>
        <quick-add-modal
          id='QuickAdd-{{ card_product.id }}'
          class='fixed inset-0 invisible is-active:visible is-active:block z-[1000] opacity-0 transition-opacity transition-[visibility] duration-200 is-active:opacity-100'
        >
          <div class='fixed inset-0 bg-black-100/50' id='OverlayClose-{{ card_product.id }}'></div>
          <div
            role='dialog'
            aria-label='{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}'
            aria-modal='true'
            class='fixed inset-0 flex items-center justify-center p-[4.267vw] lg:p-[1.111vw]'
            tabindex='-1'
          >
            <div class='relative bg-white-100 rounded-[2.133vw] lg:rounded-[0.556vw] lg:max-w-[46.667vw] w-full max-h-[90vh] p-[6.4vw] lg:p-[1.667vw] overflow-y-auto'>
              <button
                id='ModalClose-{{ card_product.id }}'
                class='absolute top-[4.267vw] lg:top-[1.111vw] right-[4.267vw] lg:right-[1.111vw] flex items-center justify-center hover:bg-gray-100 rounded-[1.067vw] lg:rounded-[0.278vw] [&_svg]:w-[5.037vw] lg:[&_svg]:w-[1.312vw] [&_svg]:h-[5.037vw] lg:[&_svg]:h-[1.312vw] w-[8.533vw] lg:w-[2.222vw] h-[8.533vw] lg:h-[2.222vw]'
                aria-label='{{ 'accessibility.close' | t }}'
              >
                {{- 'icon-close.svg' | inline_asset_content -}}
              </button>
              <div id='QuickAddInfo-{{ card_product.id }}'></div>
            </div>
          </div>
        </quick-add-modal>
      </div>
    </div>
  </div>
</div>

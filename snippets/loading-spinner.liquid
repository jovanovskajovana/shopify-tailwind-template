{% comment %}
  Renders a loading spinner

  Accepts:
  - variant: {String} 'light' for dark backgrounds (optional)
  - size: {String} sizing classes (optional)
  - class: {String} additional classes (optional)

  Usage:
  {% render 'loading-spinner' %}
  {% render 'loading-spinner', variant: 'light', size: 'w-[4.8vw] lg:w-[1.25vw] h-[4.8vw] lg:h-[1.25vw]' %}
{% endcomment %}

<span
  class='inline-block border-2 rounded-full animate-spin{% if variant == 'light' %} border-white-100/30 border-t-white-100{% else %} border-gray-300 border-t-black{% endif %}{% if size %} {{ size }}{% else %} w-[5.333vw] lg:w-[1.389vw] h-[5.333vw] lg:h-[1.389vw]{% endif %}{% if class %} {{ class }}{% endif %}'
  role='status'
  aria-label='{{ 'accessibility.loading' | t }}'
>
  <span class='sr-only'>{{ 'accessibility.loading' | t }}</span>
</span>

{% comment %}
  Renders the cookie consent banner.

  Usage:
  {% render 'cookie-banner' %}
{% endcomment %}

<style>
  #shopify-pc__banner {
    display: none !important;
  }
</style>

<div
  class='fixed bottom-0 right-0 w-full sm:max-w-md p-4 sm:p-6 z-[999] translate-y-full transition-transform duration-500 ease-out'
  data-cookie-banner
>
  <div class='bg-white-100 border border-gray-200 rounded-lg p-6 shadow-lg'>
    <h3 class='text-lg text-black-100 font-bold mb-2'>
      {{ 'sections.cookie_banner.title' | t }}
    </h3>
    <p class='text-sm text-gray-600 leading-relaxed mb-4'>
      {{ 'sections.cookie_banner.text' | t }}
      {%- if pages['privacy-policy'] != blank %}
        <a
          href='{{ pages['privacy-policy'].url }}'
          class='hover:text-black-100 underline transition-colors'
        >
          {{ 'sections.cookie_banner.privacy_link' | t -}}</a
        >.
      {%- endif -%}
    </p>
    <div class='flex items-center justify-between gap-4'>
      <button
        type='button'
        class='text-sm text-gray-600 hover:text-black-100 underline transition-colors'
        data-cookie-manage
      >
        {{ 'sections.cookie_banner.manage' | t }}
      </button>
      <div class='flex items-center gap-2'>
        <button
          type='button'
          class='hover:bg-gray-100 border border-black-100 rounded text-sm text-black-100 py-2 px-4 transition-colors'
          data-cookie-decline
        >
          {{ 'sections.cookie_banner.decline' | t }}
        </button>
        <button
          type='button'
          class='bg-black-100 hover:bg-gray-800 rounded text-sm text-white-100 py-2 px-4 transition-colors'
          data-cookie-accept
        >
          {{ 'sections.cookie_banner.accept' | t }}
        </button>
      </div>
    </div>
  </div>
</div>

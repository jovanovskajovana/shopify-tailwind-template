<script src='{{ 'cart.js' | asset_url }}' defer='defer'></script>

{% comment %}
  Renders the cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

<cart-drawer
  id='CartDrawer-Container'
  class='fixed top-0 left-0 flex justify-end bg-black-100/50 w-screen h-full opacity-0 invisible transition-all duration-300 z-[1000]{% if cart == empty %} is-empty{% endif %}'
>
  <div id='CartDrawer' class='relative w-full lg:w-[35vw] h-full'>
    <div
      id='CartDrawer-Panel'
      class='flex flex-col bg-white-100 w-full h-full overflow-hidden transform translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.25,0.46,0.45,0.94)]'
      role='dialog'
      aria-modal='true'
      aria-label='{{ 'sections.cart.title' | t }}'
      tabindex='-1'
    >
      <div class='flex flex-col p-[5.333vw] lg:p-[1.389vw]'>
        <div class='flex items-center justify-between border-b w-full pb-[3.2vw] lg:pb-[0.833vw]'>
          <h2 id='CartDrawer-Title' class='text-[5.333vw] lg:text-[1.389vw] font-semibold leading-[1.4]'>
            {{ 'sections.cart.title' | t }}
            <span id='CartDrawer-TitleCount' class='text-[3.733vw] lg:text-[0.972vw] leading-[1.429]'>({{ cart.item_count }})</span>
          </h2>
          <button
            id='CartDrawer-Close'
            class='flex items-center justify-center bg-transparent [&_svg]:w-[5.037vw] lg:[&_svg]:w-[1.312vw] [&_svg]:h-[5.037vw] lg:[&_svg]:h-[1.312vw] w-[9.6vw] lg:w-[2.5vw] h-[9.6vw] lg:h-[2.5vw] cursor-pointer'
            type='button'
            onclick="this.closest('cart-drawer').close()"
            aria-label='{{ 'accessibility.close' | t }}'
          >
            <span class='sr-only'>Close</span>
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
        </div>
      </div>

      {%- if cart == empty -%}
        <div id='CartDrawer-Empty' class='flex flex-col items-center justify-center h-full p-[5.333vw] lg:p-[1.389vw]'>
          <h2 class='text-[5.333vw] lg:text-[1.389vw] font-semibold leading-[1.4] mb-[4.267vw] lg:mb-[1.111vw]'>{{ 'sections.cart.empty' | t }}</h2>
          <p class='text-[3.733vw] lg:text-[0.972vw] leading-[1.429]'>{{ 'sections.cart.empty_start_adding' | t }}</p>
        </div>
      {%- endif -%}

      <cart-drawer-items id='CartDrawer-Items' class='flex-1 overflow-auto'>
        <form
          action='{{ routes.cart_url }}'
          id='CartDrawer-Form'
          method='post'
        >
          <div id='CartDrawer-CartItems' class='p-[5.333vw] lg:p-[1.389vw] js-contents'>
            {%- if cart != empty -%}
              <div class='flex flex-col space-y-[4.267vw] lg:space-y-[1.111vw]' role='table'>
                {%- for item in cart.items -%}
                  <div id='CartDrawer-Item-{{ item.index | plus: 1 }}' class='flex gap-[4.267vw] lg:gap-[1.111vw]' role='row'>
                    <div class='rounded-[1.067vw] lg:rounded-[0.278vw] w-[21.333vw] lg:w-[5.556vw] h-[21.333vw] lg:h-[5.556vw] flex-shrink-0 overflow-hidden' role='cell' headers='CartDrawer-ColumnProductImage'>
                      <a href='{{ item.url }}' tabindex='-1' aria-hidden='true'>
                        {%- if item.image != blank -%}
                          {{
                            item.image
                            | image_url: width: 320
                            | image_tag:
                              widths: '80, 160, 240, 320',
                              sizes: '80px',
                              alt: item.title,
                              loading: 'lazy',
                              class: 'w-full h-full object-cover'
                          }}
                        {%- endif -%}
                      </a>
                    </div>
                    <div class='flex flex-col flex-1 min-w-0' role='cell' headers='CartDrawer-ColumnProduct'>
                      <a href='{{ item.url }}' class='text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5] mb-[1.067vw] lg:mb-[0.278vw]'>
                        {{- item.product.title | escape -}}
                      </a>

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        {%- if item.product.has_only_default_variant == false -%}
                          <div class='text-[3.733vw] lg:text-[0.972vw] text-gray-600 leading-[1.429] mb-[1.067vw] lg:mb-[0.278vw]'>
                            {%- for option in item.options_with_values -%}
                              {{ option.value -}}
                              {%- unless forloop.last %}, {% endunless %}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}

                        {%- if item.properties.size != 0 -%}
                          <div class='text-[3.733vw] lg:text-[0.972vw] text-gray-600 leading-[1.429] mb-[1.067vw] lg:mb-[0.278vw]'>
                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                {%- if property.last contains '/uploads/' -%}
                                  <a
                                    href='{{ property.last }}'
                                    class='underline'
                                    target='_blank'
                                    aria-describedby='a11y-new-window-message'
                                  >
                                    {{ property.last | split: '/' | last }}
                                  </a>
                                {%- else -%}
                                  <p>{{ property.last }}</p>
                                {%- endif -%}
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      {%- endif -%}

                      <div class='mt-auto' role='cell' headers='CartDrawer-ColumnQuantity'>
                        <div class='flex items-center gap-[2.133vw] lg:gap-[0.556vw]'>
                          <quantity-input class='relative quantity'>
                            <select
                              class='appearance-none bg-white-100 border rounded-[1.067vw] lg:rounded-[0.278vw] text-[3.733vw] lg:text-[0.972vw] leading-[1.429] py-[1.067vw] lg:py-[0.278vw] pl-[2.133vw] lg:pl-[0.556vw] pr-[5.333vw] lg:pr-[1.389vw]'
                              data-quantity-variant-id='{{ item.variant.id }}'
                              name='updates[]'
                              data-cart-quantity='{{ cart | item_count_for_variant: item.variant.id }}'
                              aria-label='{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}'
                              id='Drawer-quantity-{{ item.index | plus: 1 }}'
                              data-index='{{ item.index | plus: 1 }}'
                            >
                              {% assign available_stock = item.variant.inventory_quantity %}
                              {% assign max_quantity = available_stock %}
                              {% if max_quantity > 30 %}
                                {% assign max_quantity = 30 %}
                              {% endif %}
                              {% for i in (1..max_quantity) %}
                                <option
                                  value='{{ i }}'
                                  {% if item.quantity == i %}
                                    selected
                                  {% endif %}
                                >
                                  {{ i }}
                                </option>
                              {% endfor %}
                            </select>
                            <span class='absolute top-1/2 right-[2.133vw] lg:right-[0.556vw] flex [&_svg]:w-[2.133vw] lg:[&_svg]:w-[0.556vw] [&_svg]:h-[1.28vw] lg:[&_svg]:h-[0.334vw] -translate-y-1/2 pointer-events-none' aria-hidden='true'>
                              {{- 'icon-chevron.svg' | inline_asset_content -}}
                            </span>
                          </quantity-input>

                          <cart-remove-button
                            id='CartDrawer-Remove-{{ item.index | plus: 1 }}'
                            data-index='{{ item.index | plus: 1 }}'
                          >
                            <button
                              type='button'
                              class='text-[3.733vw] lg:text-[0.972vw] text-red-600 leading-[1.429] underline'
                              aria-label='{{ 'sections.cart.remove_title' | t: title: item.title | escape }}'
                              data-variant-id='{{ item.variant.id }}'
                            >
                              {{- 'sections.cart.remove' | t -}}
                            </button>
                          </cart-remove-button>
                        </div>
                      </div>
                    </div>

                    <div class='shrink-0 text-right' role='cell' headers='CartDrawer-ColumnTotal'>
                      {%- if item.original_line_price != item.final_line_price -%}
                        <div class='flex flex-col items-end'>
                          <s class='text-[3.733vw] lg:text-[0.972vw] text-gray-500 leading-[1.429] line-through'>
                            {{ item.original_line_price | money }}
                          </s>
                          <span class='text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5]'>
                            {{ item.final_line_price | money }}
                          </span>
                        </div>
                      {%- else -%}
                        <span class='text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5]'>
                          {{ item.original_line_price | money }}
                        </span>
                      {%- endif -%}
                    </div>
                  </div>
                  <div
                    id='CartDrawer-LineItemError-{{ item.index | plus: 1 }}'
                    class='text-[3.733vw] lg:text-[0.972vw] text-red-600 leading-[1.429]'
                    role='alert'
                  >
                    <span id='CartDrawer-LineItemErrorText-{{ item.index | plus: 1 }}' class='cart-item-error-text'></span>
                  </div>
                {%- endfor -%}
              </div>
              <div class='border-t pt-[4.267vw] lg:pt-[1.111vw] mt-[4.267vw] lg:mt-[1.111vw]'>
                <div class='flex justify-between text-[3.733vw] lg:text-[0.972vw] leading-[1.429] mb-[2.133vw] lg:mb-[0.556vw]'>
                  <span>{{ 'customer.order.subtotal' | t }}</span>
                  <span class='text-[4.267vw] lg:text-[1.111vw] font-semibold leading-[1.5]'>{{ cart.items_subtotal_price | money }}</span>
                </div>
              </div>
            {%- endif -%}
            <p id='CartDrawer-LiveRegionText' class='sr-only' role='status'></p>
            <p id='CartDrawer-LineItemStatus' class='sr-only' aria-hidden='true' role='status'>
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div class='text-[3.733vw] lg:text-[0.972vw] text-red-600 leading-[1.429] text-center mb-[2.133vw] lg:mb-[0.556vw]' id='CartDrawer-CartErrors' role='alert'></div>
        </form>
      </cart-drawer-items>

      <div class='bg-gray-50 border-t p-[5.333vw] lg:p-[1.389vw]'>
        <button
          type='submit'
          id='CartDrawer-Checkout'
          class='bg-black-100 hover:bg-gray-800 rounded-[1.067vw] lg:rounded-[0.278vw] text-[4.267vw] lg:text-[1.111vw] text-white-100 font-semibold leading-[1.5] w-full py-[3.2vw] lg:py-[0.833vw] px-[4.267vw] lg:px-[1.111vw] transition-colors'
          name='checkout'
          form='CartDrawer-Form'
          {% if cart == empty %}
            disabled
          {% endif %}
        >
          {{ 'sections.cart.checkout' | t }}
        </button>
      </div>
    </div>
    <div
      id='CartDrawer-LoadingSpinner'
      class='absolute top-0 left-0 hidden flex items-center justify-center bg-white-100/80 w-full h-full pointer-events-none'
    >
      <span id='CartDrawer-LoadingSpinnerInner' class='loading-spinner'></span>
    </div>
  </div>
</cart-drawer>
